class ScreenDimmer:
    # 1. The Constructor (sets up initial variables/state)
    def __init__(self, owner_name):
        self.owner = owner_name       
        self.is_active = False       

    # 2. Method to turn the dimmer ON
    def activate_dimmer(self):
        self.is_active = True
        print(f"Privacy screen activated for {self.owner}!")

    # 3. Method to turn the dimmer OFF
    def deactivate_dimmer(self):
        self.is_active = False
        print("Privacy screen turned off. Back to normal brightness.")

# --- How to run it ---
    # Create an object from our class
    my_screen = ScreenDimmer("Student")
    
    # Call the methods
    my_screen.activate_dimmer()
    my_screen.deactivate_dimmer()

