class PasswordMasker:
   # 1. The Constructor (sets up initial variables/state)
    def __init__(self, raw_password):
        self.raw_password = raw_password  
        self.is_masked = True             

  # 2. Method to hide/obfuscate the password
    def mask_password(self):
        self.is_masked = True
        hidden = "******"                 
        print(f"Masked password: {hidden}")

   # 3. Method to reveal the password
    def reveal_password(self):
        self.is_masked = False
        print(f"Revealed password: {self.raw_password}")

# --- How to run it ---
  masker = PasswordMasker("MySecurePassword")
  masker.mask_password()
  masker.reveal_password()
