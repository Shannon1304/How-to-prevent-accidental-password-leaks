class MultiFactorAuth:
    # 1. The Constructor (sets up initial variables/state)
    def __init__(self, username):
        self.username = username       
        self.is_logged_in = False      

    # 2. First factor: Password check method
    def verify_password(self, password):
        print(f"Password verified for user: {self.username}")

    # 3. Second factor: OTP (One-Time Password) check method
    def verify_otp(self, otp_code):
        self.is_logged_in = True
        print("OTP code verified! Multi-Factor Authentication successful.")

# --- How to run it ---
    mfa = MultiFactorAuth("Student123")
    mfa.verify_password("Secret123")
    mfa.verify_otp("482910")

